{% comment %}
  Site Header — Cyberpunk / Gaming UI
  Version: 1.0.0
  Compatible with: Shopify OS 2.0+
  Style: Cyberpunk / Gaming UI — matches Build Your Setup / Brand Partners / Gaming Experience sections
{% endcomment %}

{%- liquid
  assign section_id    = 'hdr-' | append: section.id
  assign logo_text     = section.settings.logo_text     | default: shop.name
  assign announcement  = section.settings.announcement_text
  assign show_ann      = section.settings.show_announcement
-%}

<style>
  /* ============================================
     CSS VARIABLES — unified token system
  ============================================ */
  #{{ section_id }} {
    --hdr-bg:            #0A0A0A;
    --hdr-bg-card:       #0F0F0F;
    --hdr-bg-elevated:   #141414;
    --hdr-bg-dropdown:   #0D0D0D;
    --hdr-primary:       #B11226;
    --hdr-accent:        #FF2A2A;
    --hdr-cyan:          #00F0FF;
    --hdr-gold:          #FFB800;
    --hdr-white:         #FFFFFF;
    --hdr-text-muted:    rgba(255,255,255,0.5);
    --hdr-text-dim:      rgba(255,255,255,0.25);
    --hdr-border:        rgba(255,255,255,0.06);
    --hdr-border-hover:  rgba(177,18,38,0.5);
    --hdr-glow-red:      0 0 20px rgba(255,42,42,0.3);
    --hdr-glow-red-lg:   0 0 50px rgba(177,18,38,0.25);
    --hdr-glow-cyan:     0 0 20px rgba(0,240,255,0.3);
    --hdr-transition:    all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    --hdr-transition-fast: all 0.18s ease;
    --hdr-height-ann:    36px;
    --hdr-height-nav:    68px;
  }

  /* ============================================
     RESET WITHIN SCOPE
  ============================================ */
  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  #{{ section_id }} button {
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
  }

  #{{ section_id }} ul,
  #{{ section_id }} ol {
    list-style: none;
  }

  /* ============================================
     WRAPPER
  ============================================ */
  #{{ section_id }} {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    isolation: isolate;
  }

  /* ============================================
     ANNOUNCEMENT BAR
  ============================================ */
  #{{ section_id }} .hdr-announcement {
    width: 100%;
    height: var(--hdr-height-ann);
    background: var(--hdr-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Animated shimmer */
  #{{ section_id }} .hdr-announcement::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,255,255,0.06) 40%,
      rgba(255,255,255,0.1) 50%,
      rgba(255,255,255,0.06) 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: hdr-shimmer 3s linear infinite;
  }

  @keyframes hdr-shimmer {
    from { background-position: -200% 0; }
    to   { background-position: 200% 0; }
  }

  #{{ section_id }} .hdr-announcement-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  #{{ section_id }} .hdr-announcement-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.7);
    box-shadow: 0 0 8px rgba(255,255,255,0.5);
    animation: hdr-pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes hdr-pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.7); }
  }

  #{{ section_id }} .hdr-announcement-text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hdr-white);
  }

  #{{ section_id }} .hdr-announcement-text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .hdr-announcement-text a:hover {
    opacity: 1;
  }

  #{{ section_id }} .hdr-announcement-close {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.6);
    transition: color 0.2s ease;
    z-index: 2;
  }

  #{{ section_id }} .hdr-announcement-close:hover {
    color: var(--hdr-white);
  }

  /* ============================================
     MAIN NAV BAR
  ============================================ */
  #{{ section_id }} .hdr-navbar {
    width: 100%;
    height: var(--hdr-height-nav);
    background: var(--hdr-bg);
    border-bottom: 1px solid var(--hdr-border);
    position: relative;
    display: flex;
    align-items: stretch;
    transition: var(--hdr-transition);
  }

  /* Bottom accent line */
  #{{ section_id }} .hdr-navbar::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--hdr-primary) 20%,
      var(--hdr-accent) 50%,
      var(--hdr-primary) 80%,
      transparent 100%
    );
    box-shadow: var(--hdr-glow-red);
    opacity: 0.6;
  }

  /* Scrolled state */
  #{{ section_id }}.is-scrolled .hdr-navbar {
    background: rgba(10,10,10,0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.6), var(--hdr-glow-red);
    border-bottom-color: rgba(177,18,38,0.25);
  }

  /* Grid lines bg */
  #{{ section_id }} .hdr-navbar-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(177,18,38,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(177,18,38,0.015) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    opacity: 0.5;
  }

  #{{ section_id }} .hdr-navbar-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    height: 100%;
  }

  /* ============================================
     LOGO
  ============================================ */
  #{{ section_id }} .hdr-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    justify-self: start;
  }

  /* Logo image */
  #{{ section_id }} .hdr-logo-img {
    height: 36px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: brightness(1);
    transition: var(--hdr-transition);
  }

  #{{ section_id }} .hdr-logo:hover .hdr-logo-img {
    filter: brightness(1.1) drop-shadow(0 0 8px rgba(255,42,42,0.4));
  }

  /* Logo text fallback */
  #{{ section_id }} .hdr-logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  #{{ section_id }} .hdr-logo-name {
    font-family: 'Arial Black', 'Impact', sans-serif;
    font-size: 20px;
    font-weight: 900;
    color: var(--hdr-white);
    text-transform: uppercase;
    letter-spacing: -0.5px;
    line-height: 1;
    transition: var(--hdr-transition);
  }

  #{{ section_id }} .hdr-logo-name mark {
    background: none;
    color: transparent;
    -webkit-text-stroke: 1px var(--hdr-primary);
  }

  #{{ section_id }} .hdr-logo-tagline {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hdr-text-dim);
    line-height: 1;
  }

  /* Logo mark / icon */
  #{{ section_id }} .hdr-logo-mark {
    width: 36px;
    height: 36px;
    background: var(--hdr-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    transition: var(--hdr-transition);
  }

  #{{ section_id }} .hdr-logo:hover .hdr-logo-mark {
    box-shadow: var(--hdr-glow-red);
  }

  #{{ section_id }} .hdr-logo:hover .hdr-logo-name {
    text-shadow: 0 0 20px rgba(255,255,255,0.15);
  }

  /* ============================================
     PRIMARY NAVIGATION
  ============================================ */
  #{{ section_id }} .hdr-nav {
    display: flex;
    align-items: stretch;
    gap: 0;
    height: 100%;
    justify-self: center;
  }

  /* Nav item wrapper */
  #{{ section_id }} .hdr-nav-item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  /* Nav link */
  #{{ section_id }} .hdr-nav-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hdr-text-muted);
    text-decoration: none;
    position: relative;
    transition: var(--hdr-transition-fast);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  #{{ section_id }} .hdr-nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hdr-primary), var(--hdr-accent));
    box-shadow: var(--hdr-glow-red);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  #{{ section_id }} .hdr-nav-link:hover,
  #{{ section_id }} .hdr-nav-item.is-open > .hdr-nav-link {
    color: var(--hdr-white);
  }

  #{{ section_id }} .hdr-nav-link:hover::after,
  #{{ section_id }} .hdr-nav-item.is-open > .hdr-nav-link::after {
    transform: scaleX(1);
  }

  /* Active link */
  #{{ section_id }} .hdr-nav-link.is-active {
    color: var(--hdr-white);
  }

  #{{ section_id }} .hdr-nav-link.is-active::after {
    transform: scaleX(1);
  }

  /* Chevron */
  #{{ section_id }} .hdr-nav-chevron {
    width: 12px;
    height: 12px;
    color: var(--hdr-text-dim);
    transition: transform 0.25s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-nav-item.is-open .hdr-nav-chevron {
    transform: rotate(180deg);
    color: var(--hdr-accent);
  }

  /* HOT badge */
  #{{ section_id }} .hdr-nav-badge {
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 5px;
    background: var(--hdr-primary);
    color: var(--hdr-white);
    box-shadow: var(--hdr-glow-red);
    flex-shrink: 0;
    line-height: 1.4;
  }

  /* ============================================
     MEGA DROPDOWN
  ============================================ */
  #{{ section_id }} .hdr-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: var(--hdr-bg-dropdown);
    border: 1px solid var(--hdr-border);
    border-top: none;
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      visibility 0s linear 0.22s;
    z-index: 100;
    overflow: hidden;
  }

  /* Top accent */
  #{{ section_id }} .hdr-dropdown::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hdr-primary), var(--hdr-accent), transparent);
    box-shadow: var(--hdr-glow-red);
  }

  #{{ section_id }} .hdr-nav-item.is-open .hdr-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      visibility 0s linear 0s;
  }

  /* Mega dropdown (wide) */
  #{{ section_id }} .hdr-dropdown--mega {
    min-width: 600px;
    left: 0;
    transform: translateY(8px);
  }

  #{{ section_id }} .hdr-nav-item.is-open .hdr-dropdown--mega {
    transform: translateY(0);
  }

  /* Standard dropdown list */
  #{{ section_id }} .hdr-dropdown-list {
    padding: 8px 0;
  }

  #{{ section_id }} .hdr-dropdown-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--hdr-text-muted);
    text-decoration: none;
    transition: var(--hdr-transition-fast);
    position: relative;
    border-left: 2px solid transparent;
    white-space: nowrap;
  }

  #{{ section_id }} .hdr-dropdown-link::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--hdr-accent);
    box-shadow: var(--hdr-glow-red);
    transform: scaleY(0);
    transition: transform 0.2s ease;
  }

  #{{ section_id }} .hdr-dropdown-link:hover {
    color: var(--hdr-white);
    background: rgba(177,18,38,0.05);
    padding-left: 26px;
  }

  #{{ section_id }} .hdr-dropdown-link:hover::before {
    transform: scaleY(1);
  }

  #{{ section_id }} .hdr-dropdown-divider {
    height: 1px;
    background: var(--hdr-border);
    margin: 6px 0;
  }

  /* Mega dropdown grid */
  #{{ section_id }} .hdr-mega-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
  }

  #{{ section_id }} .hdr-mega-col {
    padding: 24px 24px 20px;
    border-right: 1px solid var(--hdr-border);
  }

  #{{ section_id }} .hdr-mega-col:last-child {
    border-right: none;
  }

  #{{ section_id }} .hdr-mega-col-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hdr-accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #{{ section_id }} .hdr-mega-col-title::before {
    content: '';
    display: block;
    width: 12px;
    height: 1px;
    background: var(--hdr-accent);
    box-shadow: var(--hdr-glow-red);
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-mega-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #{{ section_id }} .hdr-mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--hdr-text-muted);
    text-decoration: none;
    transition: var(--hdr-transition-fast);
    letter-spacing: 0.3px;
    border-left: 2px solid transparent;
    position: relative;
  }

  #{{ section_id }} .hdr-mega-link:hover {
    color: var(--hdr-white);
    background: rgba(177,18,38,0.06);
    border-left-color: var(--hdr-accent);
    padding-left: 14px;
  }

  #{{ section_id }} .hdr-mega-link-badge {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 6px;
    background: rgba(177,18,38,0.15);
    color: var(--hdr-accent);
    border: 1px solid rgba(255,42,42,0.2);
    flex-shrink: 0;
  }

  /* Featured card inside mega */
  #{{ section_id }} .hdr-mega-featured {
    padding: 20px;
    background: rgba(177,18,38,0.04);
    border: 1px solid rgba(177,18,38,0.12);
    margin: 16px 24px 20px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: var(--hdr-transition);
    cursor: pointer;
    text-decoration: none;
  }

  #{{ section_id }} .hdr-mega-featured::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hdr-primary), var(--hdr-accent), transparent);
    box-shadow: var(--hdr-glow-red);
  }

  #{{ section_id }} .hdr-mega-featured:hover {
    border-color: rgba(255,42,42,0.3);
    background: rgba(177,18,38,0.08);
  }

  #{{ section_id }} .hdr-mega-featured-label {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hdr-accent);
  }

  #{{ section_id }} .hdr-mega-featured-title {
    font-family: 'Arial Black', 'Impact', sans-serif;
    font-size: 14px;
    font-weight: 900;
    color: var(--hdr-white);
    text-transform: uppercase;
    letter-spacing: -0.3px;
    line-height: 1.2;
  }

  #{{ section_id }} .hdr-mega-featured-sub {
    font-size: 11px;
    color: var(--hdr-text-muted);
    line-height: 1.5;
  }

  #{{ section_id }} .hdr-mega-featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--hdr-accent);
    margin-top: 4px;
  }

  /* ============================================
     RIGHT ACTIONS
  ============================================ */
  #{{ section_id }} .hdr-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-self: end;
  }

  /* Icon button base */
  #{{ section_id }} .hdr-icon-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hdr-text-muted);
    border: 1px solid transparent;
    transition: var(--hdr-transition-fast);
    position: relative;
    text-decoration: none;
    flex-shrink: 0;
    background: transparent;
  }

  #{{ section_id }} .hdr-icon-btn:hover {
    color: var(--hdr-white);
    border-color: var(--hdr-border);
    background: rgba(255,255,255,0.04);
  }

  #{{ section_id }} .hdr-icon-btn:focus-visible {
    outline: 2px solid var(--hdr-accent);
    outline-offset: 2px;
  }

  /* Cart count badge */
  #{{ section_id }} .hdr-cart-count {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--hdr-primary);
    color: var(--hdr-white);
    font-size: 9px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    box-shadow: var(--hdr-glow-red);
    line-height: 1;
    opacity: 0;
    transform: scale(0.5);
    transition: var(--hdr-transition-fast);
    pointer-events: none;
  }

  #{{ section_id }} .hdr-cart-count.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* Search expansion */
  #{{ section_id }} .hdr-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  #{{ section_id }} .hdr-search-form {
    display: flex;
    align-items: center;
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    transition:
      max-width 0.4s cubic-bezier(0.25,0.46,0.45,0.94),
      opacity   0.3s ease;
  }

  #{{ section_id }} .hdr-search-wrap.is-open .hdr-search-form {
    max-width: 220px;
    opacity: 1;
  }

  #{{ section_id }} .hdr-search-input {
    background: var(--hdr-bg-elevated);
    border: 1px solid var(--hdr-border);
    border-right: none;
    color: var(--hdr-white);
    font-family: inherit;
    font-size: 12px;
    padding: 8px 12px;
    outline: none;
    width: 220px;
    letter-spacing: 0.3px;
    transition: border-color 0.2s ease;
  }

  #{{ section_id }} .hdr-search-input::placeholder {
    color: var(--hdr-text-dim);
  }

  #{{ section_id }} .hdr-search-input:focus {
    border-color: var(--hdr-border-hover);
    box-shadow: var(--hdr-glow-red);
  }

  #{{ section_id }} .hdr-search-submit {
    width: 36px;
    height: 36px;
    background: var(--hdr-primary);
    border: 1px solid var(--hdr-primary);
    color: var(--hdr-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: var(--hdr-transition-fast);
  }

  #{{ section_id }} .hdr-search-submit:hover {
    background: var(--hdr-accent);
    box-shadow: var(--hdr-glow-red);
  }

  /* CTA button */
  #{{ section_id }} .hdr-cta-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    height: 36px;
    background: var(--hdr-primary);
    color: var(--hdr-white);
    font-family: 'Arial Black', 'Impact', sans-serif;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--hdr-transition);
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    flex-shrink: 0;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  #{{ section_id }} .hdr-cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .hdr-cta-btn:hover {
    box-shadow: var(--hdr-glow-red-lg);
    transform: translateY(-1px);
    text-decoration: none;
    color: var(--hdr-white);
  }

  #{{ section_id }} .hdr-cta-btn:hover::before {
    opacity: 1;
  }

  #{{ section_id }} .hdr-cta-btn svg {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-cta-btn span {
    position: relative;
    z-index: 1;
  }

  /* Divider between actions */
  #{{ section_id }} .hdr-action-divider {
    width: 1px;
    height: 20px;
    background: var(--hdr-border);
    flex-shrink: 0;
    margin: 0 4px;
  }

  /* ============================================
     MOBILE HAMBURGER
  ============================================ */
  #{{ section_id }} .hdr-hamburger {
    width: 40px;
    height: 40px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--hdr-border);
    cursor: pointer;
    transition: var(--hdr-transition-fast);
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-hamburger:hover {
    border-color: var(--hdr-border-hover);
    background: rgba(177,18,38,0.06);
  }

  #{{ section_id }} .hdr-hamburger-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--hdr-text-muted);
    transition: var(--hdr-transition);
    transform-origin: center;
  }

  #{{ section_id }} .hdr-hamburger.is-open .hdr-hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
    background: var(--hdr-accent);
  }

  #{{ section_id }} .hdr-hamburger.is-open .hdr-hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  #{{ section_id }} .hdr-hamburger.is-open .hdr-hamburger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
    background: var(--hdr-accent);
  }

  /* ============================================
     MOBILE DRAWER
  ============================================ */
  #{{ section_id }} .hdr-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: min(360px, 90vw);
    height: 100vh;
    background: var(--hdr-bg-card);
    border-right: 1px solid var(--hdr-border);
    z-index: 2000;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  #{{ section_id }} .hdr-drawer.is-open {
    transform: translateX(0);
  }

  /* Drawer top accent */
  #{{ section_id }} .hdr-drawer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hdr-primary), var(--hdr-accent), transparent);
    box-shadow: var(--hdr-glow-red);
    z-index: 2;
  }

  /* Drawer header */
  #{{ section_id }} .hdr-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--hdr-border);
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-drawer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  #{{ section_id }} .hdr-drawer-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hdr-text-muted);
    border: 1px solid var(--hdr-border);
    transition: var(--hdr-transition-fast);
    background: transparent;
    cursor: pointer;
  }

  #{{ section_id }} .hdr-drawer-close:hover {
    color: var(--hdr-accent);
    border-color: var(--hdr-border-hover);
    background: rgba(177,18,38,0.08);
  }

  /* Drawer search */
  #{{ section_id }} .hdr-drawer-search {
    padding: 16px 24px;
    border-bottom: 1px solid var(--hdr-border);
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-drawer-search-form {
    display: flex;
    align-items: center;
  }

  #{{ section_id }} .hdr-drawer-search-input {
    flex: 1;
    background: var(--hdr-bg-elevated);
    border: 1px solid var(--hdr-border);
    border-right: none;
    color: var(--hdr-white);
    font-family: inherit;
    font-size: 12px;
    padding: 10px 12px;
    outline: none;
    letter-spacing: 0.3px;
    transition: border-color 0.2s ease;
  }

  #{{ section_id }} .hdr-drawer-search-input::placeholder {
    color: var(--hdr-text-dim);
  }

  #{{ section_id }} .hdr-drawer-search-input:focus {
    border-color: var(--hdr-border-hover);
  }

  #{{ section_id }} .hdr-drawer-search-btn {
    width: 40px;
    height: 40px;
    background: var(--hdr-primary);
    border: none;
    color: var(--hdr-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  /* Drawer nav */
  #{{ section_id }} .hdr-drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(177,18,38,0.3) transparent;
  }

  #{{ section_id }} .hdr-drawer-nav::-webkit-scrollbar {
    width: 3px;
  }

  #{{ section_id }} .hdr-drawer-nav::-webkit-scrollbar-thumb {
    background: rgba(177,18,38,0.3);
  }

  #{{ section_id }} .hdr-drawer-nav-item {
    border-bottom: 1px solid var(--hdr-border);
  }

  #{{ section_id }} .hdr-drawer-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hdr-text-muted);
    text-decoration: none;
    transition: var(--hdr-transition-fast);
    border-left: 2px solid transparent;
  }

  #{{ section_id }} .hdr-drawer-nav-link:hover,
  #{{ section_id }} .hdr-drawer-nav-item.is-open > .hdr-drawer-nav-link {
    color: var(--hdr-white);
    background: rgba(177,18,38,0.04);
    border-left-color: var(--hdr-accent);
    padding-left: 28px;
  }

  #{{ section_id }} .hdr-drawer-chevron {
    width: 14px;
    height: 14px;
    color: var(--hdr-text-dim);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-drawer-nav-item.is-open .hdr-drawer-chevron {
    transform: rotate(180deg);
    color: var(--hdr-accent);
  }

  /* Drawer sub-menu */
  #{{ section_id }} .hdr-drawer-submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: rgba(0,0,0,0.2);
  }

  #{{ section_id }} .hdr-drawer-nav-item.is-open .hdr-drawer-submenu {
    max-height: 400px;
  }

  #{{ section_id }} .hdr-drawer-sub-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px 11px 36px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--hdr-text-dim);
    text-decoration: none;
    transition: var(--hdr-transition-fast);
    border-left: 2px solid transparent;
  }

  #{{ section_id }} .hdr-drawer-sub-link::before {
    content: '';
    display: block;
    width: 4px;
    height: 4px;
    background: rgba(255,42,42,0.4);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  #{{ section_id }} .hdr-drawer-sub-link:hover {
    color: var(--hdr-white);
    background: rgba(177,18,38,0.05);
    border-left-color: var(--hdr-accent);
    padding-left: 44px;
  }

  /* Drawer footer */
  #{{ section_id }} .hdr-drawer-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--hdr-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
    background: var(--hdr-bg-elevated);
  }

  #{{ section_id }} .hdr-drawer-cta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 20px;
    background: var(--hdr-primary);
    color: var(--hdr-white);
    font-family: 'Arial Black', sans-serif;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--hdr-transition);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  #{{ section_id }} .hdr-drawer-cta:hover {
    box-shadow: var(--hdr-glow-red-lg);
    text-decoration: none;
    color: var(--hdr-white);
  }

  #{{ section_id }} .hdr-drawer-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  #{{ section_id }} .hdr-drawer-icon-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    border: 1px solid var(--hdr-border);
    color: var(--hdr-text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--hdr-transition-fast);
    background: transparent;
  }

  #{{ section_id }} .hdr-drawer-icon-link:hover {
    color: var(--hdr-white);
    border-color: var(--hdr-border-hover);
    background: rgba(177,18,38,0.06);
  }

  /* ============================================
     OVERLAY
  ============================================ */
  #{{ section_id }} .hdr-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
    backdrop-filter: blur(4px);
  }

  #{{ section_id }} .hdr-overlay.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease, visibility 0s linear 0s;
  }

  /* ============================================
     RESPONSIVE — TABLET
  ============================================ */
  @media (max-width: 1100px) {
    #{{ section_id }} .hdr-navbar-inner {
      padding: 0 24px;
      grid-template-columns: auto 1fr auto;
    }

    #{{ section_id }} .hdr-nav {
      display: none;
    }

    #{{ section_id }} .hdr-hamburger {
      display: flex;
    }

    #{{ section_id }} .hdr-cta-btn .hdr-cta-text {
      display: none;
    }

    #{{ section_id }} .hdr-cta-btn {
      width: 40px;
      padding: 0;
      justify-content: center;
      clip-path: none;
    }
  }

  /* ============================================
     RESPONSIVE — MOBILE
  ============================================ */
  @media (max-width: 640px) {
    #{{ section_id }} .hdr-navbar-inner {
      padding: 0 16px;
      gap: 16px;
    }

    #{{ section_id }} .hdr-logo-tagline {
      display: none;
    }

    #{{ section_id }} .hdr-search-wrap {
      display: none;
    }

    #{{ section_id }} .hdr-announcement-text {
      font-size: 10px;
      letter-spacing: 1px;
    }
  }

  /* ============================================
     REDUCED MOTION
  ============================================ */
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<div id="{{ section_id }}">

  {% comment %} Overlay {% endcomment %}
  <div class="hdr-overlay" id="hdr-overlay-{{ section.id }}" aria-hidden="true"></div>

  {% comment %} ============================================
     ANNOUNCEMENT BAR
  ============================================ {% endcomment %}
  {% if show_ann and announcement != blank %}
    <div
      class="hdr-announcement"
      id="hdr-ann-{{ section.id }}"
      role="banner"
      aria-label="Announcement"
    >
      <div class="hdr-announcement-inner">
        <div class="hdr-announcement-dot" aria-hidden="true"></div>
        <p class="hdr-announcement-text">{{ announcement }}</p>
      </div>

      <button
        class="hdr-announcement-close"
        id="hdr-ann-close-{{ section.id }}"
        aria-label="Close announcement"
        type="button"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  {% endif %}

  {% comment %} ============================================
     MAIN NAVBAR
  ============================================ {% endcomment %}
  <nav
    class="hdr-navbar"
    id="hdr-nav-{{ section.id }}"
    aria-label="Main navigation"
  >
    <div class="hdr-navbar-grid" aria-hidden="true"></div>

    <div class="hdr-navbar-inner">

      {% comment %} LOGO {% endcomment %}
      <a
        href="{{ routes.root_url }}"
        class="hdr-logo"
        aria-label="{{ shop.name }} — Home"
      >
        <div class="hdr-logo-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white" stroke="white" stroke-width="0.5"/>
          </svg>
        </div>

        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 280
            | image_tag:
              class: 'hdr-logo-img',
              loading: 'eager',
              alt: shop.name,
              widths: '140, 200, 280'
          }}
        {% else %}
          <div class="hdr-logo-text">
            <span class="hdr-logo-name">
              {{ logo_text | split: ' ' | first -}}
              <mark>
                {%- assign logo_words = logo_text | split: ' ' -%}
                {%- for w in logo_words -%}
                  {%- unless forloop.first -%}{{ w }}{% unless forloop.last %} {% endunless %}{%- endunless -%}
                {%- endfor -%}
              </mark>
            </span>
            {% if section.settings.logo_tagline != blank %}
              <span class="hdr-logo-tagline">{{ section.settings.logo_tagline }}</span>
            {% endif %}
          </div>
        {% endif %}
      </a>

      {% comment %} PRIMARY NAV {% endcomment %}
      <ul class="hdr-nav" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            {%- liquid
              assign has_children = false
              if block.settings.sub_1_label != blank or block.settings.mega_col_1_title != blank
                assign has_children = true
              endif
              assign is_mega = block.settings.is_mega
            -%}
            <li
              class="hdr-nav-item"
              {{ block.shopify_attributes }}
              {%- if has_children -%}
                data-dropdown
              {%- endif -%}
            >
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="hdr-nav-link{% if request.path == block.settings.url %} is-active{% endif %}"
                {%- if has_children -%}
                  aria-haspopup="true"
                  aria-expanded="false"
                {%- endif -%}
              >
                {{ block.settings.label | default: 'Link' }}

                {% if block.settings.badge != blank %}
                  <span class="hdr-nav-badge" aria-label="{{ block.settings.badge }}">{{ block.settings.badge }}</span>
                {% endif %}

                {%- if has_children -%}
                  <svg class="hdr-nav-chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>

              {%- if has_children -%}
                {%- if is_mega -%}
                  {% comment %} MEGA DROPDOWN {% endcomment %}
                  <div class="hdr-dropdown hdr-dropdown--mega" role="region" aria-label="{{ block.settings.label }} menu">

                    <div class="hdr-mega-inner">
                      {% comment %} Column 1 {% endcomment %}
                      {% if block.settings.mega_col_1_title != blank %}
                        <div class="hdr-mega-col">
                          <div class="hdr-mega-col-title">{{ block.settings.mega_col_1_title }}</div>
                          <ul class="hdr-mega-links" role="list">
                            {%- for i in (1..6) -%}
                              {%- assign lbl_key = 'mega_col_1_link_' | append: i | append: '_label' -%}
                              {%- assign url_key = 'mega_col_1_link_' | append: i | append: '_url' -%}
                              {%- assign bdg_key = 'mega_col_1_link_' | append: i | append: '_badge' -%}
                              {%- if block.settings[lbl_key] != blank -%}
                                <li>
                                  <a href="{{ block.settings[url_key] | default: '#' }}" class="hdr-mega-link">
                                    {{ block.settings[lbl_key] }}
                                    {%- if block.settings[bdg_key] != blank -%}
                                      <span class="hdr-mega-link-badge">{{ block.settings[bdg_key] }}</span>
                                    {%- endif -%}
                                  </a>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {% endif %}

                      {% comment %} Column 2 {% endcomment %}
                      {% if block.settings.mega_col_2_title != blank %}
                        <div class="hdr-mega-col">
                          <div class="hdr-mega-col-title">{{ block.settings.mega_col_2_title }}</div>
                          <ul class="hdr-mega-links" role="list">
                            {%- for i in (1..6) -%}
                              {%- assign lbl_key = 'mega_col_2_link_' | append: i | append: '_label' -%}
                              {%- assign url_key = 'mega_col_2_link_' | append: i | append: '_url' -%}
                              {%- assign bdg_key = 'mega_col_2_link_' | append: i | append: '_badge' -%}
                              {%- if block.settings[lbl_key] != blank -%}
                                <li>
                                  <a href="{{ block.settings[url_key] | default: '#' }}" class="hdr-mega-link">
                                    {{ block.settings[lbl_key] }}
                                    {%- if block.settings[bdg_key] != blank -%}
                                      <span class="hdr-mega-link-badge">{{ block.settings[bdg_key] }}</span>
                                    {%- endif -%}
                                  </a>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {% endif %}

                      {% comment %} Column 3 {% endcomment %}
                      {% if block.settings.mega_col_3_title != blank %}
                        <div class="hdr-mega-col">
                          <div class="hdr-mega-col-title">{{ block.settings.mega_col_3_title }}</div>
                          <ul class="hdr-mega-links" role="list">
                            {%- for i in (1..6) -%}
                              {%- assign lbl_key = 'mega_col_3_link_' | append: i | append: '_label' -%}
                              {%- assign url_key = 'mega_col_3_link_' | append: i | append: '_url' -%}
                              {%- assign bdg_key = 'mega_col_3_link_' | append: i | append: '_badge' -%}
                              {%- if block.settings[lbl_key] != blank -%}
                                <li>
                                  <a href="{{ block.settings[url_key] | default: '#' }}" class="hdr-mega-link">
                                    {{ block.settings[lbl_key] }}
                                    {%- if block.settings[bdg_key] != blank -%}
                                      <span class="hdr-mega-link-badge">{{ block.settings[bdg_key] }}</span>
                                    {%- endif -%}
                                  </a>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {% endif %}
                    </div>

                    {% comment %} Featured promo card {% endcomment %}
                    {% if block.settings.mega_promo_title != blank %}
                      <a href="{{ block.settings.mega_promo_url | default: '#' }}" class="hdr-mega-featured">
                        <span class="hdr-mega-featured-label">{{ block.settings.mega_promo_label | default: 'Featured' }}</span>
                        <span class="hdr-mega-featured-title">{{ block.settings.mega_promo_title }}</span>
                        {% if block.settings.mega_promo_sub != blank %}
                          <span class="hdr-mega-featured-sub">{{ block.settings.mega_promo_sub }}</span>
                        {% endif %}
                        <span class="hdr-mega-featured-cta">
                          {{ block.settings.mega_promo_cta | default: 'Shop Now' }}
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M5 12H19M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </a>
                    {% endif %}

                  </div>

                {%- else -%}
                  {% comment %} STANDARD DROPDOWN {% endcomment %}
                  <div class="hdr-dropdown" role="region" aria-label="{{ block.settings.label }} submenu">
                    <ul class="hdr-dropdown-list" role="list">
                      {%- for i in (1..8) -%}
                        {%- assign sub_lbl = 'sub_' | append: i | append: '_label' -%}
                        {%- assign sub_url = 'sub_' | append: i | append: '_url' -%}
                        {%- if block.settings[sub_lbl] != blank -%}
                          {%- if block.settings[sub_lbl] == '---' -%}
                            <li class="hdr-dropdown-divider" role="separator" aria-hidden="true"></li>
                          {%- else -%}
                            <li>
                              <a
                                href="{{ block.settings[sub_url] | default: '#' }}"
                                class="hdr-dropdown-link"
                              >
                                {{ block.settings[sub_lbl] }}
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {% comment %} RIGHT ACTIONS {% endcomment %}
      <div class="hdr-actions">

        {% comment %} Search {% endcomment %}
        {% if section.settings.show_search %}
          <div class="hdr-search-wrap" id="hdr-search-wrap-{{ section.id }}">
            <form class="hdr-search-form" action="{{ routes.search_url }}" method="get" role="search" id="hdr-search-form-{{ section.id }}">
              <input
                type="search"
                name="q"
                class="hdr-search-input"
                placeholder="{{ section.settings.search_placeholder | default: 'Search gear...' }}"
                aria-label="Search"
                autocomplete="off"
              >
              <input type="hidden" name="type" value="product">
              <button class="hdr-search-submit" type="submit" aria-label="Submit search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
                  <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </form>

            <button
              class="hdr-icon-btn"
              id="hdr-search-toggle-{{ section.id }}"
              aria-label="Toggle search"
              aria-expanded="false"
              type="button"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/>
                <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        {% endif %}

        <div class="hdr-action-divider" aria-hidden="true"></div>

        {% comment %} Account {% endcomment %}
        {% if section.settings.show_account %}
          <a
            href="{{ routes.account_url }}"
            class="hdr-icon-btn"
            aria-label="{% if customer %}My Account{% else %}Sign In{% endif %}"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/>
              <path d="M4 20C4 16.686 7.582 14 12 14C16.418 14 20 16.686 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        {% comment %} Wishlist {% endcomment %}
        {% if section.settings.show_wishlist %}
          <a
            href="{{ section.settings.wishlist_url | default: '#' }}"
            class="hdr-icon-btn"
            aria-label="Wishlist"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}

        {% comment %} Cart {% endcomment %}
        <a
          href="{{ routes.cart_url }}"
          class="hdr-icon-btn"
          aria-label="Cart ({{ cart.item_count }} items)"
          id="hdr-cart-btn-{{ section.id }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 2L3 6V20C3 21.105 3.895 22 5 22H19C20.105 22 21 21.105 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M3 6H21M16 10C16 12.209 14.209 14 12 14C9.791 14 8 12.209 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span
            class="hdr-cart-count{% if cart.item_count > 0 %} is-visible{% endif %}"
            id="hdr-cart-count-{{ section.id }}"
            aria-label="{{ cart.item_count }} items in cart"
          >{{ cart.item_count }}</span>
        </a>

        <div class="hdr-action-divider" aria-hidden="true"></div>

        {% comment %} Desktop CTA {% endcomment %}
        {% if section.settings.cta_text != blank %}
          <a
            href="{{ section.settings.cta_url | default: '#' }}"
            class="hdr-cta-btn"
            aria-label="{{ section.settings.cta_text }}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
            </svg>
            <span class="hdr-cta-text">{{ section.settings.cta_text }}</span>
          </a>
        {% endif %}

        {% comment %} Hamburger {% endcomment %}
        <button
          class="hdr-hamburger"
          id="hdr-hamburger-{{ section.id }}"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="hdr-drawer-{{ section.id }}"
          type="button"
        >
          <span class="hdr-hamburger-line"></span>
          <span class="hdr-hamburger-line"></span>
          <span class="hdr-hamburger-line"></span>
        </button>

      </div>
      {% comment %} END .hdr-actions {% endcomment %}

    </div>
  </nav>

  {% comment %} ============================================
     MOBILE DRAWER
  ============================================ {% endcomment %}
  <div
    class="hdr-drawer"
    id="hdr-drawer-{{ section.id }}"
    aria-label="Mobile navigation"
    role="dialog"
    aria-modal="true"
  >

    <div class="hdr-drawer-head">
      <a href="{{ routes.root_url }}" class="hdr-drawer-logo" aria-label="{{ shop.name }}">
        <div class="hdr-logo-mark" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white"/>
          </svg>
        </div>
        <span class="hdr-logo-name" style="font-family:'Arial Black',Impact,sans-serif;font-size:16px;font-weight:900;color:var(--hdr-white);text-transform:uppercase;letter-spacing:-0.3px;">
          {{ logo_text }}
        </span>
      </a>

      <button
        class="hdr-drawer-close"
        id="hdr-drawer-close-{{ section.id }}"
        aria-label="Close menu"
        type="button"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {% comment %} Drawer search {% endcomment %}
    <div class="hdr-drawer-search">
      <form class="hdr-drawer-search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input
          type="search"
          name="q"
          class="hdr-drawer-search-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search gear...' }}"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
        <button class="hdr-drawer-search-btn" type="submit" aria-label="Search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </form>
    </div>

    {% comment %} Drawer nav items {% endcomment %}
    <nav class="hdr-drawer-nav" aria-label="Mobile navigation">
      <ul role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            {%- liquid
              assign has_children = false
              if block.settings.sub_1_label != blank or block.settings.mega_col_1_title != blank
                assign has_children = true
              endif
            -%}
            <li class="hdr-drawer-nav-item">
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="hdr-drawer-nav-link"
                {%- if has_children -%}
                  data-drawer-toggle
                  aria-expanded="false"
                {%- endif -%}
              >
                {{ block.settings.label | default: 'Link' }}
                {% if block.settings.badge != blank %}
                  <span class="hdr-nav-badge">{{ block.settings.badge }}</span>
                {% endif %}
                {%- if has_children -%}
                  <svg class="hdr-drawer-chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>

              {%- if has_children -%}
                <ul class="hdr-drawer-submenu" role="list">
                  {%- for i in (1..8) -%}
                    {%- assign sub_lbl = 'sub_' | append: i | append: '_label' -%}
                    {%- assign sub_url = 'sub_' | append: i | append: '_url' -%}
                    {%- if block.settings[sub_lbl] != blank and block.settings[sub_lbl] != '---' -%}
                      <li>
                        <a href="{{ block.settings[sub_url] | default: '#' }}" class="hdr-drawer-sub-link">
                          {{ block.settings[sub_lbl] }}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}

                  {% comment %} Mega links in drawer {% endcomment %}
                  {%- for col in (1..3) -%}
                    {%- assign col_title_key = 'mega_col_' | append: col | append: '_title' -%}
                    {%- if block.settings[col_title_key] != blank -%}
                      {%- for i in (1..6) -%}
                        {%- assign lbl_key = 'mega_col_' | append: col | append: '_link_' | append: i | append: '_label' -%}
                        {%- assign url_key = 'mega_col_' | append: col | append: '_link_' | append: i | append: '_url' -%}
                        {%- if block.settings[lbl_key] != blank -%}
                          <li>
                            <a href="{{ block.settings[url_key] | default: '#' }}" class="hdr-drawer-sub-link">
                              {{ block.settings[lbl_key] }}
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {% comment %} Drawer footer {% endcomment %}
    <div class="hdr-drawer-footer">
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ section.settings.cta_url | default: '#' }}"
          class="hdr-drawer-cta"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
          </svg>
          {{ section.settings.cta_text }}
        </a>
      {% endif %}

      <div class="hdr-drawer-icons">
        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="hdr-drawer-icon-link" aria-label="Account">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/>
              <path d="M4 20C4 16.686 7.582 14 12 14C16.418 14 20 16.686 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            Account
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="hdr-drawer-icon-link" aria-label="Cart">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 2L3 6V20C3 21.105 3.895 22 5 22H19C20.105 22 21 21.105 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M3 6H21M16 10C16 12.209 14.209 14 12 14C9.791 14 8 12.209 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Cart ({{ cart.item_count }})
        </a>
      </div>
    </div>

  </div>
  {% comment %} END .hdr-drawer {% endcomment %}

</div>

<script>
(function () {
  'use strict';

  const SID     = '{{ section.id }}';
  const WRAPPER = document.getElementById('hdr-' + SID);
  if (!WRAPPER) return;

  // ============================================
  // ELEMENTS
  // ============================================
  const navbar      = document.getElementById('hdr-nav-' + SID);
  const hamburger   = document.getElementById('hdr-hamburger-' + SID);
  const drawer      = document.getElementById('hdr-drawer-' + SID);
  const drawerClose = document.getElementById('hdr-drawer-close-' + SID);
  const overlay     = document.getElementById('hdr-overlay-' + SID);
  const annBar      = document.getElementById('hdr-ann-' + SID);
  const annClose    = document.getElementById('hdr-ann-close-' + SID);
  const searchWrap  = document.getElementById('hdr-search-wrap-' + SID);
  const searchToggle= document.getElementById('hdr-search-toggle-' + SID);
  const searchInput = searchWrap ? searchWrap.querySelector('.hdr-search-input') : null;
  const cartCount   = document.getElementById('hdr-cart-count-' + SID);

  // ============================================
  // SCROLL — sticky shadow
  // ============================================
  function onScroll () {
    WRAPPER.classList.toggle('is-scrolled', window.scrollY > 20);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ============================================
  // ANNOUNCEMENT CLOSE
  // ============================================
  if (annClose && annBar) {
    annClose.addEventListener('click', function () {
      annBar.style.height = annBar.offsetHeight + 'px';
      requestAnimationFrame(function () {
        annBar.style.transition = 'height 0.3s ease, opacity 0.3s ease';
        annBar.style.height  = '0';
        annBar.style.opacity = '0';
        annBar.style.overflow = 'hidden';
      });
      setTimeout(function () { annBar.remove(); }, 350);
      try { sessionStorage.setItem('hdr_ann_closed_' + SID, '1'); } catch(e){}
    });

    // Restore dismissed state
    try {
      if (sessionStorage.getItem('hdr_ann_closed_' + SID)) annBar.style.display = 'none';
    } catch(e) {}
  }

  // ============================================
  // MOBILE DRAWER
  // ============================================
  function openDrawer () {
    drawer.classList.add('is-open');
    overlay.classList.add('is-visible');
    hamburger.classList.add('is-open');
    hamburger.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Focus first focusable element
    const firstFocus = drawer.querySelector('a, button, input');
    if (firstFocus) setTimeout(function () { firstFocus.focus(); }, 50);
  }

  function closeDrawer () {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-visible');
    hamburger.classList.remove('is-open');
    hamburger.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    hamburger.focus();
  }

  if (hamburger)   hamburger.addEventListener('click', openDrawer);
  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
  if (overlay)     overlay.addEventListener('click', closeDrawer);

  // Drawer submenu toggles
  drawer.querySelectorAll('[data-drawer-toggle]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      const item = link.closest('.hdr-drawer-nav-item');
      if (!item) return;
      const submenu = item.querySelector('.hdr-drawer-submenu');
      if (!submenu) return;
      e.preventDefault();
      const isOpen = item.classList.contains('is-open');
      // Close siblings
      drawer.querySelectorAll('.hdr-drawer-nav-item.is-open').forEach(function (el) {
        el.classList.remove('is-open');
        el.querySelector('[aria-expanded]') && el.querySelector('[aria-expanded]').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        link.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Escape key
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (drawer.classList.contains('is-open')) closeDrawer();
      if (searchWrap && searchWrap.classList.contains('is-open')) closeSearch();
      closeAllDropdowns();
    }
  });

  // ============================================
  // DESKTOP DROPDOWNS
  // ============================================
  const dropdownItems = navbar ? navbar.querySelectorAll('[data-dropdown]') : [];
  let   hoverTimer    = null;

  function openDropdown (item) {
    closeAllDropdowns();
    item.classList.add('is-open');
    const link = item.querySelector('.hdr-nav-link');
    if (link) link.setAttribute('aria-expanded', 'true');
  }

  function closeAllDropdowns () {
    dropdownItems.forEach(function (item) {
      item.classList.remove('is-open');
      const link = item.querySelector('.hdr-nav-link');
      if (link) link.setAttribute('aria-expanded', 'false');
    });
  }

  dropdownItems.forEach(function (item) {
    item.addEventListener('mouseenter', function () {
      clearTimeout(hoverTimer);
      openDropdown(item);
    });

    item.addEventListener('mouseleave', function () {
      hoverTimer = setTimeout(closeAllDropdowns, 120);
    });

    // Keyboard: Enter/Space on trigger
    const link = item.querySelector('.hdr-nav-link');
    if (link) {
      link.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          const dropdown = item.querySelector('.hdr-dropdown');
          if (dropdown) {
            e.preventDefault();
            const isOpen = item.classList.contains('is-open');
            isOpen ? closeAllDropdowns() : openDropdown(item);
          }
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          openDropdown(item);
          const firstLink = item.querySelector('.hdr-dropdown a, .hdr-dropdown button');
          if (firstLink) firstLink.focus();
        }
      });
    }
  });

  // Close dropdowns on outside click
  document.addEventListener('click', function (e) {
    if (navbar && !navbar.contains(e.target)) closeAllDropdowns();
  });

  // ============================================
  // SEARCH TOGGLE
  // ============================================
  function openSearch () {
    if (!searchWrap) return;
    searchWrap.classList.add('is-open');
    searchToggle.setAttribute('aria-expanded', 'true');
    if (searchInput) setTimeout(function () { searchInput.focus(); }, 300);
  }

  function closeSearch () {
    if (!searchWrap) return;
    searchWrap.classList.remove('is-open');
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false');
  }

  if (searchToggle) {
    searchToggle.addEventListener('click', function () {
      searchWrap.classList.contains('is-open') ? closeSearch() : openSearch();
    });
  }

  // Close search on outside click
  document.addEventListener('click', function (e) {
    if (searchWrap && !searchWrap.contains(e.target)) closeSearch();
  });

  // ============================================
  // CART COUNT — live update via section events
  // ============================================
  document.addEventListener('cart:updated', function (e) {
    if (!cartCount) return;
    const count = e.detail && e.detail.cart ? e.detail.cart.item_count : 0;
    cartCount.textContent = count;
    cartCount.classList.toggle('is-visible', count > 0);
    cartCount.setAttribute('aria-label', count + ' items in cart');
  });

  // Initial cart fetch for accuracy
  fetch('/cart.js')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (!cartCount) return;
      const count = data.item_count || 0;
      cartCount.textContent = count;
      cartCount.classList.toggle('is-visible', count > 0);
    })
    .catch(function () {});

  // ============================================
  // TRAP FOCUS IN DRAWER
  // ============================================
  drawer.addEventListener('keydown', function (e) {
    if (e.key !== 'Tab') return;
    const focusable = drawer.querySelectorAll(
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

}());
</script>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "site-header-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Recommended height: 36–48px. PNG with transparency preferred."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "GameStore",
      "info": "Used when no logo image is set. First word will be solid, remaining words will be outlined."
    },
    {
      "type": "text",
      "id": "logo_tagline",
      "label": "Logo Tagline",
      "default": "Pro Gaming Gear",
      "info": "Small text shown below the logo name."
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "🎮 Free shipping on orders over $99 — Use code LEVELUP at checkout",
      "info": "Supports basic HTML links."
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search gaming gear..."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Icon",
      "default": false
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist URL"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Build Setup"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "header",
          "content": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "info": "e.g. New, Hot, Sale. Leave blank to hide.",
        },
        {
          "type": "header",
          "content": "Standard Dropdown"
        },
        {
          "type": "paragraph",
          "content": "Add up to 8 sub-links. Use --- as a label to render a divider line."
        },
        { "type": "text", "id": "sub_1_label", "label": "Sub-link 1 Label", "default": "Gaming Chairs" },
        { "type": "url",  "id": "sub_1_url",   "label": "Sub-link 1 URL" },
