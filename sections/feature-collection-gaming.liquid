    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "header",
          "content": "Card Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "PlayStation"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Label",
          "default": "Console"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product Count Text",
          "default": "120+ Products",
          "info": "e.g. '120+ Products' or '50 Items'"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link URL"
        },
        {
          "type": "header",
          "content": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image",
          "info": "Recommended: 600x800px (portrait) for tall cards. Use high-contrast images."
        },
        {
          "type": "select",
          "id": "placeholder_icon",
          "label": "Placeholder Icon (if no image)",
          "options": [
            { "value": "playstation", "label": "PlayStation" },
            { "value": "xbox", "label": "Xbox" },
            { "value": "chair", "label": "Gaming Chair" },
            { "value": "controller", "label": "Controller / Default" }
          ],
          "default": "controller"
        },
        {
          "type": "header",
          "content": "Card Style"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Aspect Ratio",
          "options": [
            { "value": "tall", "label": "Tall (3:4 Portrait)" },
            { "value": "square", "label": "Square (1:1)" },
            { "value": "wide", "label": "Wide (16:9 Landscape)" }
          ],
          "default": "tall"
