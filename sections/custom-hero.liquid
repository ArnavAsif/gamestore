    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Rating"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 Number",
