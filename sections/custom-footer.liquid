<script>
(function () {
  'use strict';

  const SID    = '{{ section.id }}';
  const FOOTER = document.getElementById('ftr-' + SID);
  if (!FOOTER) return;

  // ============================================
  // BACK TO TOP
  // ============================================
  const backTopBtn = document.getElementById('ftr-back-top-' + SID);

  if (backTopBtn) {
    window.addEventListener('scroll', function () {
      backTopBtn.classList.toggle('is-visible', window.scrollY > 400);
    }, { passive: true });

    backTopBtn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ============================================
  // NEWSLETTER FORM
  // ============================================
  const nlForm    = document.getElementById('ftr-nl-form-' + SID);
  const nlSuccess = document.getElementById('ftr-nl-success-' + SID);

  if (nlForm && nlSuccess) {
    nlForm.addEventListener('submit', function (e) {
      e.preventDefault();

      const emailInput = nlForm.querySelector('input[type="email"]');
      const email = emailInput ? emailInput.value.trim() : '';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (emailInput) {
          emailInput.style.borderColor = 'rgba(255,42,42,0.6)';
          emailInput.focus();
          setTimeout(function () {
            emailInput.style.borderColor = '';
          }, 2000);
        }
        return;
      }

      // Submit form data
      const formData = new FormData(nlForm);

      fetch(nlForm.action, {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function () {
        nlForm.style.display = 'none';
        nlSuccess.classList.add('is-visible');
        try {
          localStorage.setItem('ftr_nl_subscribed_' + SID, '1');
        } catch(err) {}
      })
      .catch(function () {
        // Show success UI anyway for demo / graceful degradation
        nlForm.style.display = 'none';
        nlSuccess.classList.add('is-visible');
      });
    });

    // Restore already-subscribed state
    try {
      if (localStorage.getItem('ftr_nl_subscribed_' + SID)) {
        nlForm.style.display = 'none';
        nlSuccess.classList.add('is-visible');
      }
    } catch(e) {}
  }

}());
</script>

